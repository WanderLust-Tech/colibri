/* The icon and the name Windows shows for colibri-tray.exe (Task Manager reads FileDescription). */
#include <winver.h>

1 ICON "tray.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Colibri"
            VALUE "FileDescription", "Colibri tray"
            VALUE "InternalName", "colibri-tray"
            VALUE "OriginalFilename", "colibri-tray.exe"
            VALUE "ProductName", "Colibri"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
